#!/bin/sh /etc/rc.common

START=90
STOP=1
USE_PROCD=1

PROG=/etc/config/presence-detector.py
CONFIG=/etc/config/presence-detector.settings.json

start_service() {
    procd_open_instance instance1
    if ubus -v list service 2>/dev/null | grep -q '"watchdog"' &&
        grep -q watchdog /lib/functions/procd.sh; then
        procd_set_param command "$PROG" -c "$CONFIG" --procd-watchdog
        procd_set_param watchdog 1 60
    else
        procd_set_param command "$PROG" -c "$CONFIG"
        logger -t presence-detector "procd watchdog unavailable; using respawn only"
    fi
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_set_param respawn 3600 5 5
    procd_set_param term_timeout 15
    procd_close_instance
}
